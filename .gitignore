# secrets — every local env variant (Vercel writes .env*.local); keep .env.example tracked
.env
.env*.local

# vercel CLI link metadata
.vercel/

# python
__pycache__/
*.pyc
.venv/

# node / next
node_modules/
.next/
out/
next-env.d.ts

# data (raw tex/pdf + extracted text live on disk, not in git)
data/

# agent memory — candid by design (incidents, what went wrong, what it cost),
# so it stays local. .claude/settings.json is tracked: it carries the LINEAGE_NO_DB
# guard, which is worth sharing and holds no secret.
.claude/memory/

# misc
.DS_Store
*.log

# typescript incremental build state
app/tsconfig.tsbuildinfo
