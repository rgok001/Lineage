# Copy to .env and fill in. Never commit .env.

# Postgres. Primary: a Neon connection string (Dashboard > Connect > psql).
# Neon supports pgvector, so migration 001 runs against it unchanged.
# Append ?sslmode=require if the string doesn't already include it.
DATABASE_URL=postgresql://<user>:<password>@<host>.neon.tech/<db>?sslmode=require
# Read-only connection, used by the Operator agent and nothing else. The
# lineage_ro role holds SELECT and no other privilege. Create it with SQL rather
# than the Neon Console, whose roles are granted neon_superuser, and verify the
# grant by attempting a write and being refused. Named separately from
# DATABASE_URL on purpose: every connection in the pipeline calls
# env("DATABASE_URL"), so a distinct name cannot be reached by existing code.
LINEAGE_READ_URL=postgresql://lineage_ro:<password>@<host>.neon.tech/<db>?sslmode=require
# Local fallback (needs Docker Desktop + `docker compose up -d`):
# DATABASE_URL=postgresql://lineage:lineage@localhost:5432/lineage

# LLM pipeline
ANTHROPIC_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
# Embeddings via the Voyage hosted API (Anthropic's recommended partner; free
# tier). Used for corpus relevance and definition clustering — no local model.
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3
# Model for Stage B extraction. Default claude-opus-4-8; claude-sonnet-5 matched
# it on the showcase papers at ~60% the cost. Not part of the extraction cache
# key — bump PROMPT_VERSION to force re-extraction with a different model.
LLM_MODEL=claude-sonnet-5

# OpenAlex polite pool — identifies us and gets better rate limits
OPENALEX_MAILTO=ravi.gokal@gmail.com

# Cost discipline: abort any trace that would exceed this (USD)
TRACE_SPEND_CAP_USD=10

# Bump to invalidate per-paper extraction caches
PROMPT_VERSION=v1

# Where raw tex/pdf and extracted text are stored
DATA_DIR=./data

# Who a CLI curatorial edit says it was made by. Optional: defaults to
# user@host, which is noise inside a container. Recorded as `by_asserted` and
# rendered as unverified, because nothing here authenticates anyone — it is a
# label, not a credential. Whitespace is collapsed, parentheses and the middle
# dot are dropped and the name is capped at 64 characters, since it renders on
# a public page and inside a Markdown export.
# LINEAGE_ACTOR=ravi@laptop

# ── Refusing the database on purpose ─────────────────────────────────────
# Set LINEAGE_NO_DB to anything non-blank and every PYTHON script in this repo
# will refuse to hand out DATABASE_URL: the pipeline, the worker and the
# migrator all take their connection string from common.env(), so none of them
# can connect and none of them can write. Set it whenever you are running
# pipeline code to inspect it rather than to operate on real data: a test
# harness, an agent working offline, a scratch experiment against a CLI's main().
# It can be turned on but not off inside a running process. Removing the
# variable does not lift it, because removing an environment variable to
# sandbox a harness is what caused incident 14 in the first place.
#
# IT DOES NOT COVER THE NODE SIDE, and the app is where the writes are.
# app/lib/db.ts reads process.env.DATABASE_URL directly, so `npm run dev`
# connects whatever this is set to. app/scripts/check-db.mjs,
# check-auth-env.mjs and security-test.mjs each regex DATABASE_URL out of
# app/.env.local without consulting the environment at all, and security-test
# fires mutation payloads at every Server Action it can find. Nothing here
# stops any of them.
# LINEAGE_NO_DB=1

# ── App auth (app/.env.local, not this file) ─────────────────────────────
# Register a GitHub OAuth app: Settings > Developer settings > OAuth Apps.
# Callback URL: http://localhost:3000/api/auth/callback/github
#   AUTH_GITHUB_ID=...
#   AUTH_GITHUB_SECRET=...
#   AUTH_SECRET=...              generated by app/scripts/gen-auth-secret.mjs
#   OWNER_GITHUB_LOGIN=rgok001   only this login may edit; unset = nobody can
